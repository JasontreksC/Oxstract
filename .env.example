# 빈 자리표시자만 둔다. .env로 복사해 로컬에서 채우고, .env는 커밋하지 않는다.

# Docker Compose로 띄울 때 호스트에 여는 포트. 기본 8000.
APP_PORT=

# 로컬 실행 때 영상과 SQLite DB를 둘 폴더. 기본 ./data
MEDIA_ROOT=
CONFIG_DIR=

# PATH에 없을 때만 지정한다.
FFMPEG_BIN=
FFPROBE_BIN=

# 탐지 모델 경로. 비우면 ./models/yolo11n.onnx
DETECT_MODEL=

# 텍스트 카드 글꼴(.ttf/.otf/.ttc). 비우면 Noto Sans CJK KR을 찾는다.
FONT_FILE=

# Vite 개발 서버를 IP가 아닌 이름(예: oxstract.lan)으로 열 때 쉼표로 나열한다.
VITE_ALLOWED_HOSTS=

# 드라이브 자격 증명은 이 파일이 아니라 config/drive.yaml에 둔다.
